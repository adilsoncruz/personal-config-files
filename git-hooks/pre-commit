#!/usr/bin/env bash
# Global Git Pre-Commit Hook (Performance, Bloat & Complexity Guard)

set -e

# 1. Chain local repository hook if it exists
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -f "$REPO_ROOT/.git/hooks/pre-commit.local" ] && [ -x "$REPO_ROOT/.git/hooks/pre-commit.local" ]; then
    "$REPO_ROOT/.git/hooks/pre-commit.local" || exit 1
fi

# Get staged files (excluding deleted ones)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

ERRORS=0

echo "🔍 [pre-commit global] Verificando arquivos staged..."

# --- CHECK 1: Arquivos pesados (> 5MB) ---
MAX_BYTES=$((5 * 1024 * 1024))
while IFS= read -r FILE; do
    if [ -f "$FILE" ]; then
        SIZE=$(stat -f%z "$FILE" 2>/dev/null || stat -c%s "$FILE" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt "$MAX_BYTES" ]; then
            SIZE_MB=$(echo "scale=2; $SIZE / 1048576" | bc 2>/dev/null || echo "5+")
            echo "❌ [Bloat] Arquivo muito pesado ($SIZE_MB MB): $FILE"
            echo "   Evite comitar arquivos > 5MB. Use Git LFS ou adicione ao .gitignore."
            ERRORS=$((ERRORS + 1))
        fi
    fi
done <<< "$STAGED_FILES"

# --- CHECK 2: Complexidade e Calistenia (indentação profunda > 3 níveis em código) ---
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx|py|go|rs|java|c|cpp|rb|php)$' || true)
if [ -n "$CODE_FILES" ]; then
    while IFS= read -r FILE; do
        if [ -f "$FILE" ]; then
            # Procura linhas com indentação excessiva (>= 16 espaços ou >= 4 tabs) ignorando comentários/strings comuns
            DEEP_LINES=$(grep -n -E '^(\t{4,}| {16,})[^/ *#]' "$FILE" | head -n 3 || true)
            if [ -n "$DEEP_LINES" ]; then
                echo "⚠️  [Complexidade] $FILE possui aninhamento profundo (>= 4 níveis de indentação):"
                echo "$DEEP_LINES" | sed 's/^/   Linha /'
                echo "   💡 Dica Calistenia: Refatore usando Early Returns (Guard Clauses) ou extraia funções menores."
                # Apenas warning não-bloqueante para não travar fluxos legítimos, mantendo conscientização
            fi
        fi
    done <<< "$CODE_FILES"
fi

# --- CHECK 3: Dependências / Manifestos modificados ---
PKG_FILES=$(echo "$STAGED_FILES" | grep -E '(package\.json|requirements\.txt|pyproject\.toml|go\.mod|Cargo\.toml)$' || true)
if [ -n "$PKG_FILES" ]; then
    while IFS= read -r MANIFEST; do
        echo "📦 [Dependências] Manifesto modificado: $MANIFEST"
        case "$MANIFEST" in
            *package.json*)
                if command -v npx >/dev/null 2>&1 && [ -f "package-lock.json" ] || [ -f "yarn.lock" ] || [ -f "pnpm-lock.yaml" ]; then
                    echo "   Executando checagem rápida de dependências não utilizadas (depcheck)..."
                    npx --yes depcheck --specials=bin --skip-missing=true 2>/dev/null || true
                fi
                ;;
            *requirements.txt*)
                # Alerta se houver dependências sem versão pinada
                UNPINNED=$(grep -v -E '(^#|^$|==|>=|<=|~=)' "$MANIFEST" | head -n 3 || true)
                if [ -n "$UNPINNED" ]; then
                    echo "   ⚠️  Dependências sem versão fixada em $MANIFEST:"
                    echo "$UNPINNED" | sed 's/^/   /'
                fi
                ;;
        esac
    done <<< "$PKG_FILES"
fi

if [ "$ERRORS" -gt 0 ]; then
    echo "🚨 Commit bloqueado por $ERRORS erro(s) crítico(s). Corrija ou use 'git commit --no-verify' em emergências."
    exit 1
fi

echo "✅ [pre-commit global] Tudo limpo."
exit 0
